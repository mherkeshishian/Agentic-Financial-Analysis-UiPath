{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinanceAnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol",
    "summary",
    "trend",
    "confidence",
    "needs_review",
    "data_as_of"
  ],
  "properties": {
    "symbol": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "trend": {
      "enum": [
        "upward",
        "downward",
        "flat",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_review": {
      "type": "boolean"
    },
    "data_as_of": {
      "type": "string",
      "format": "date"
    }
  }
}
